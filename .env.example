# Copy to .env (gitignored) and fill in. Nothing here is required for the
# Sleeper commands — those hit a public, unauthenticated read API.

# --- Point the CLI at YOUR league (optional; defaults to The Ballers 2026) ---
# Set all three together. FF_LEAGUE_ID on its own points the tools at your
# league while "our team" still means this repo's author, so `ff roster` and
# `ff draft` won't find you. Blank = use the default, so delete a line rather
# than leaving a value you don't mean.
# Find them: https://api.sleeper.app/v1/user/<your_username>   -> user_id
#            https://api.sleeper.app/v1/user/<your_user_id>/leagues/nfl/2026
FF_LEAGUE_ID=
FF_USER_ID=
FF_USERNAME=

# --- Vegas layer: `ff odds` only ---
# Free key: https://the-odds-api.com  (500 credits/mo; spreads+totals = 2/call,
# responses cached 6h in .cache/, `--fresh` forces a refetch)
ODDS_API_KEY=
# ...or leave ODDS_API_KEY empty and name a command that prints the key, so it
# never lands in plaintext. Anything that writes to stdout works:
#   ODDS_API_KEY_CMD=passage show tokens/the-odds/api-key
#   ODDS_API_KEY_CMD=op read "op://Private/the-odds-api/credential"
ODDS_API_KEY_CMD=

# Optional: a command the gameday seatbelt pipes its alert into (message on
# stdin), on top of the macOS notification. Your channel, your choice.
#   FF_SEATBELT_HOOK=curl -sS -d @- https://ntfy.sh/my-ff-topic
FF_SEATBELT_HOOK=
